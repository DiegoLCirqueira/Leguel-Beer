{
  "name": "leguele-beer",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm arch",
    "arch": "depcruise --config .dependency-cruiser.cjs apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:migrate": "pnpm --filter @leguele/api db:migrate",
    "db:reset": "pnpm --filter @leguele/api db:reset",
    "db:seed": "pnpm --filter @leguele/api db:seed",
    "db:check": "pnpm --filter @leguele/api db:check"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.22",
    "dependency-cruiser": "18.7.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3"
  }
}
