{
  "name": "@leguele/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:diff": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:check": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@leguele/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@leguele/config": "workspace:*",
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.20",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "dependency-cruiser": "18.7.0",
    "dotenv": "18.0.9",
    "eslint": "10.13.0",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
