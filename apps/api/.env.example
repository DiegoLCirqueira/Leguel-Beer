# Conexão da aplicação (no local: Postgres do Supabase CLI)
DATABASE_URL=
# Conexão das migrations (no local, a mesma)
DIRECT_URL=
# Banco dos testes de integração (opcional; padrão: leguele_test no mesmo Postgres; o nome termina em _test)
TEST_DATABASE_URL=
# Origem do web permitida no CORS
WEB_ORIGIN=
# E-mail da conta admin (papel gravado pelo seed e na criação do perfil)
ADMIN_EMAIL=
# Senha da conta admin criada pelo seed de desenvolvimento (só no .env local)
ADMIN_SEED_PASSWORD=
# URL do Supabase Auth (no local: http://127.0.0.1:54321)
SUPABASE_URL=
# Chave de serviço do Supabase (no local: `pnpm exec supabase status -o env`); nunca no site
SUPABASE_SERVICE_ROLE_KEY=
