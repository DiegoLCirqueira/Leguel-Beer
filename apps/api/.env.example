# Conexão da aplicação (no local: Postgres do Supabase CLI)
DATABASE_URL=
# Conexão das migrations (no local, a mesma)
DIRECT_URL=
# Banco dos testes de integração (opcional; padrão: leguele_test no mesmo Postgres; o nome termina em _test)
TEST_DATABASE_URL=
# Origem do web permitida no CORS (em produção é obrigatória: uma única origem https, sem curinga, caminho nem vírgula)
WEB_ORIGIN=
# E-mail da conta admin (papel gravado pelo seed e na criação do perfil)
ADMIN_EMAIL=
# Senha da conta admin criada pelo seed de desenvolvimento (só no .env local)
ADMIN_SEED_PASSWORD=
# URL do Supabase Auth (no local: http://127.0.0.1:54321)
SUPABASE_URL=
# Chave de serviço do Supabase (no local: `pnpm exec supabase status -o env`); nunca no site
SUPABASE_SERVICE_ROLE_KEY=
# Segredo do cron de expiração de pedidos (a Vercel o envia como Bearer); mínimo de 32 caracteres aleatórios; sem ele a rota recusa tudo
CRON_SECRET=
# Limite de requisições por IP por minuto (opcional; padrão 100; só inteiro positivo; em produção, NODE_ENV=production ou qualquer VERCEL_ENV, o teto é 1000). Valor alto só no .env local e no E2E
THROTTLE_LIMIT=
# Mapas do MVP: `local` liga o adaptador local (coordenadas aproximadas por bairro e distância em linha reta, sem rede nem chave). Vazio ou outro valor = não configurado (503 MAPS_UNAVAILABLE)
MAPS_ADAPTER=
# Endereço público do site (link "Meus pedidos" no e-mail de confirmação; padrão http://localhost:3000)
SITE_URL=
