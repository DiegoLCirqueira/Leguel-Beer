generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

/// Perfil da conta. O id é o id do usuário no Supabase Auth; o papel mora aqui, não no Auth.
model Profile {
  id              String    @id @db.Uuid
  email           String    @unique
  role            Role      @default(CUSTOMER)
  /// Dados do cadastro e aceite dos termos; nulos no perfil que o seed do admin cria só com o papel.
  nome            String?
  telefone        String?
  termsVersion    String?   @map("terms_version")
  privacyVersion  String?   @map("privacy_version")
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("profiles")
}

/// Categoria do catálogo (IPA, Frutas, Malt, Lager); `order` define a ordem da faixa de categorias e da relevância.
model Category {
  id    String @id @default(uuid()) @db.Uuid
  slug  String @unique
  name  String
  order Int
  beers Beer[]

  @@map("categories")
}

/// Cerveja do catálogo. O preço é sempre em centavos; `stock` é o estoque físico (as reservas entram com o LB-56).
model Beer {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  name       String
  style      String
  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// Teor alcoólico em %, uma casa decimal.
  abv        Decimal  @db.Decimal(3, 1)
  ibu        Int
  volumeMl   Int      @map("volume_ml")
  priceCents Int      @map("price_cents")
  featured   Boolean  @default(false)
  active     Boolean  @default(true)
  stock      Int      @default(0)
  /// Nulo usa a imagem padrão da categoria.
  imageUrl   String?  @map("image_url")
  /// Data de cadastro: base da ordenação "mais novas".
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([categoryId])
  @@index([active, featured])
  @@map("beers")
}
