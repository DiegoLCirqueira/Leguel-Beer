# Supabase Auth, usado só no servidor do site (Server Actions e rotas); nunca em NEXT_PUBLIC_*.
# No local: `pnpm exec supabase status -o env` (API_URL e ANON_KEY).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Endereço público do site, usado no link de confirmação do e-mail. Nunca vem do cabeçalho Host.
# Obrigatório em produção; no desenvolvimento o padrão é http://localhost:3000.
SITE_URL=
